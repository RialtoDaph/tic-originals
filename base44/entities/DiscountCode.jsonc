{
  "name": "DiscountCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Rabattcode in Gro\u00dfbuchstaben (z.B. SOMMER10)"
    },
    "description": {
      "type": "string",
      "description": "Interne Notiz f\u00fcr den Admin"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "description": "Rabatttyp: percentage oder fixed EUR"
    },
    "discount_value": {
      "type": "number",
      "description": "Rabattwert \u2014 % oder EUR"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Code aktiv?"
    },
    "is_first_order_only": {
      "type": "boolean",
      "default": false,
      "description": "Nur f\u00fcr Erstkunden?"
    },
    "maximum_discount_amount": {
      "type": "number",
      "description": "Max Rabatt in EUR (nur bei percentage)"
    },
    "minimum_order_amount": {
      "type": "number",
      "default": 0,
      "description": "Mindestbestellwert in EUR"
    },
    "usage_limit": {
      "type": "number",
      "description": "Max Verwendungen gesamt (leer = unbegrenzt)"
    },
    "usage_limit_per_customer": {
      "type": "number",
      "default": 1,
      "description": "Max Verwendungen pro Kunde"
    },
    "used_count": {
      "type": "number",
      "default": 0,
      "description": "Bereits verwendet (automatisch \u2014 nicht manuell \u00e4ndern)"
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "description": "G\u00fcltig ab (YYYY-MM-DD)"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "G\u00fcltig bis (YYYY-MM-DD)"
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}