{
  "name": "ContactMessage",
  "properties": {
    "description": {
      "description": "Zus\u00e4tzliche Notizen",
      "maxLength": 1000,
      "type": "string"
    },
    "email": {
      "description": "E-Mail des Absenders",
      "type": "string"
    },
    "is_read": {
      "default": false,
      "description": "Vom Admin gelesen?",
      "type": "boolean"
    },
    "message": {
      "description": "Nachrichteninhalt",
      "type": "string"
    },
    "name": {
      "description": "Name des Absenders",
      "type": "string"
    },
    "subject": {
      "description": "Betreff",
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}