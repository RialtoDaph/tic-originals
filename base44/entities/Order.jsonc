{
  "name": "Order",
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Format TIC-2026-XXXX"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "processing",
        "shipped",
        "delivered",
        "cancelled",
        "returned"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "EUR amount discounted via code"
    },
    "applied_discount_code": {
      "type": "string",
      "description": "The discount code that was applied"
    },
    "total": {
      "type": "number"
    },
    "vat_amount": {
      "type": "number"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "de"
      ],
      "default": "de",
      "description": "Customer's preferred language for emails"
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "house_number": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "default": "Deutschland"
        }
      }
    },
    "shipping_method": {
      "type": "string",
      "enum": [
        "standard",
        "express"
      ]
    },
    "shipping_carrier": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session ID"
    },
    "stripe_payment_intent": {
      "type": "string",
      "description": "Stripe Payment Intent ID"
    },
    "stock_decremented": {
      "type": "boolean",
      "default": false,
      "description": "Whether stock has been decremented for this order (idempotency flag)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "order_number",
    "customer_email"
  ]
}