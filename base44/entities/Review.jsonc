{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID of the reviewed product"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of the reviewer"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating from 1 to 5"
    },
    "comment": {
      "type": "string",
      "description": "Review text"
    },
    "description": {
      "type": "string",
      "description": "Additional review details or summary",
      "maxLength": 1000
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "Admin muss Review genehmigen bevor er im Shop erscheint"
    }
  },
  "required": [
    "product_id",
    "author_name",
    "rating"
  ],
  "rls": {
    "create": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_approved": true
        },
        {
          "data.created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}