{
  "name": "Product",
  "properties": {
    "care_instructions_de": {
      "description": "Pflegehinweise auf Deutsch",
      "placeholder": "Bei 30\u00b0C waschen, nicht im Trockner trocknen.",
      "type": "string"
    },
    "care_instructions_en": {
      "description": "Care instructions in English",
      "placeholder": "Wash at 30\u00b0C, do not tumble dry.",
      "type": "string"
    },
    "category": {
      "description": "Produktkategorie",
      "enum": [
        "tees",
        "hoodies",
        "caps",
        "accessories",
        "other"
      ],
      "type": "string"
    },
    "colors": {
      "description": "Verf\u00fcgbare Farben",
      "items": {
        "type": "string"
      },
      "placeholder": "schwarz",
      "type": "array"
    },
    "description": {
      "description": "Kurzbeschreibung f\u00fcr SEO (max. 1000 Zeichen)",
      "maxLength": 1000,
      "placeholder": "SEO meta description...",
      "type": "string"
    },
    "description_de": {
      "description": "Produktbeschreibung auf Deutsch",
      "placeholder": "Kurze, ansprechende Beschreibung auf Deutsch...",
      "type": "string"
    },
    "description_en": {
      "description": "Product description in English",
      "placeholder": "Short, compelling description in English...",
      "type": "string"
    },
    "images": {
      "description": "Produkt-Bild-URLs \u2014 erstes Bild = Hauptbild",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "is_active": {
      "default": true,
      "description": "Produkt im Shop anzeigen?",
      "type": "boolean"
    },
    "low_stock_threshold": {
      "default": 3,
      "description": "Ab welcher Menge erscheint Warnung? (Standard: 3)",
      "type": "number"
    },
    "material": {
      "description": "Material / Zusammensetzung",
      "placeholder": "100% Baumwolle",
      "type": "string"
    },
    "name": {
      "description": "Produktname / Product name",
      "placeholder": "z.B. TIC Tees Schwarz",
      "type": "string"
    },
    "price": {
      "description": "Verkaufspreis in EUR (Kleinunternehmer \u00a7 19 UStG \u2014 keine USt.)",
      "placeholder": "25.00",
      "type": "number"
    },
    "sizes": {
      "description": "Verf\u00fcgbare Gr\u00f6\u00dfen",
      "items": {
        "enum": [
          "XS",
          "S",
          "M",
          "L",
          "XL",
          "XXL",
          "one-size"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "slug": {
      "description": "URL-Slug (z.B. tic-tees-schwarz)",
      "placeholder": "tic-tees-schwarz",
      "type": "string"
    },
    "stock": {
      "description": "Lagerbestand pro Farbe & Gr\u00f6\u00dfe",
      "items": {
        "properties": {
          "color": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "size": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "stripe_price_id": {
      "description": "Stripe Price ID",
      "placeholder": "price_...",
      "type": "string"
    },
    "tags": {
      "description": "Tags f\u00fcr Suche & Filter",
      "items": {
        "type": "string"
      },
      "placeholder": "streetwear",
      "type": "array"
    },
    "weight_grams": {
      "description": "Gewicht in Gramm",
      "placeholder": "200",
      "type": "number"
    }
  },
  "required": [
    "name",
    "price",
    "category",
    "stock"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_active": true
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}