{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "E-Mail-Adresse des Abonnenten"
    },
    "description": {
      "type": "string",
      "description": "Interne Notiz",
      "maxLength": 1000
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Abonnement aktiv?"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "de"
      ],
      "default": "de",
      "description": "Bevorzugte Sprache"
    },
    "unsubscribe_token": {
      "type": "string",
      "description": "Random token used for unsubscribe link verification"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    }
  }
}